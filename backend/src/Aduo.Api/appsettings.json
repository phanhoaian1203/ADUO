{
  "ConnectionStrings": {
    "Aduo": ""
  },
  "RateLimiting": {
    "DefaultPerMinute": 300
  },
  "Logging": {
    "FilePath": "logs/aduo-.log"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
